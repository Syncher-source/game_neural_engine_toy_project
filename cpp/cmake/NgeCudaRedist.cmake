# Fetches the CUDA / cuDNN runtime pieces the ONNX Runtime CUDA execution provider needs on
# Windows, from NVIDIA's public redistributable archives, so the game runs without a CUDA
# Toolkit install. Also exposes the cudart headers/import library for the D3D12 interop.
#
# Sets: NGE_CUDA_DLLS (list of .dll files to deploy), NGE_CUDART_INCLUDE_DIRS, NGE_CUDART_LIB
#
# Override with an installed toolkit: -DNGE_CUDA_REDIST=OFF -DCUDA_PATH=... -DCUDNN_PATH=...

set(NGE_CUDA_REDIST_VERSION "12.8.1" CACHE STRING "CUDA redistrib index version (must match the ONNX Runtime CUDA build)")
set(NGE_CUDNN_REDIST_VERSION "9.27.0" CACHE STRING "cuDNN redistrib index version")
if(WIN32)
  set(_plat "windows-x86_64")
  set(NGE_CUDA_COMPONENTS cuda_cudart libcublas libcufft libcurand cuda_nvrtc libnvjitlink)
  # headers only (crt/host_defines.h etc. needed by cuda_runtime_api.h live in the nvcc package)
  set(NGE_CUDA_HEADER_COMPONENTS cuda_nvcc)
else()
  set(_plat "linux-x86_64")
  set(NGE_CUDA_COMPONENTS cuda_nvrtc)        # runtime compiler for the deterministic kernel only
  set(NGE_CUDA_HEADER_COMPONENTS "")
endif()
set(_redist_root "${CMAKE_SOURCE_DIR}/third_party/cuda")
file(MAKE_DIRECTORY "${_redist_root}")

function(_nge_download_json url out_var)
  set(_file "${_redist_root}/${out_var}.json")
  if(NOT EXISTS "${_file}")
    file(DOWNLOAD "${url}" "${_file}" STATUS _st TLS_VERIFY ON)
    list(GET _st 0 _code)
    if(NOT _code EQUAL 0)
      file(REMOVE "${_file}")
      message(WARNING "could not download ${url}")
      set(${out_var} "" PARENT_SCOPE)
      return()
    endif()
  endif()
  file(READ "${_file}" _json)
  set(${out_var} "${_json}" PARENT_SCOPE)
endfunction()

# Downloads + extracts one archive (relative path from the index) under third_party/cuda.
# Returns the extracted directory (which contains bin/, include/, lib/).
function(_nge_fetch_archive base_url relative_path sha256 out_dir_var)
  get_filename_component(_file "${relative_path}" NAME)
  string(REGEX REPLACE "\\.(zip|tar\\.xz)$" "" _name "${_file}")   # keep the dots inside the version
  string(REGEX MATCH "\\.(zip|tar\\.xz)$" _ext "${_file}")
  set(_dir "${_redist_root}/${_name}")
  if(NOT EXISTS "${_dir}/bin" AND NOT EXISTS "${_dir}/include" AND NOT EXISTS "${_dir}/lib")
    set(_zip "${_redist_root}/${_name}${_ext}")
    message(STATUS "Downloading ${base_url}${relative_path} ...")
    if(sha256)
      file(DOWNLOAD "${base_url}${relative_path}" "${_zip}" SHOW_PROGRESS STATUS _st TLS_VERIFY ON EXPECTED_HASH SHA256=${sha256})
    else()
      file(DOWNLOAD "${base_url}${relative_path}" "${_zip}" SHOW_PROGRESS STATUS _st TLS_VERIFY ON)
    endif()
    list(GET _st 0 _code)
    if(NOT _code EQUAL 0)
      file(REMOVE "${_zip}")
      message(WARNING "download failed: ${relative_path}")
      set(${out_dir_var} "" PARENT_SCOPE)
      return()
    endif()
    file(ARCHIVE_EXTRACT INPUT "${_zip}" DESTINATION "${_redist_root}")
    file(REMOVE "${_zip}")
  endif()
  set(${out_dir_var} "${_dir}" PARENT_SCOPE)
endfunction()

set(NGE_CUDA_DLLS "")
set(NGE_CUDART_INCLUDE_DIRS "")
set(NGE_CUDART_LIB "")

if(NGE_CUDA_REDIST)
  _nge_download_json("https://developer.download.nvidia.com/compute/cuda/redist/redistrib_${NGE_CUDA_REDIST_VERSION}.json" cuda_index)
  if(cuda_index)
    foreach(_comp IN LISTS NGE_CUDA_COMPONENTS)
      string(JSON _rel ERROR_VARIABLE _err GET "${cuda_index}" "${_comp}" "${_plat}" "relative_path")
      if(_err)
        message(WARNING "CUDA redist index has no ${_plat} entry for ${_comp}: ${_err}")
        continue()
      endif()
      string(JSON _sha ERROR_VARIABLE _err2 GET "${cuda_index}" "${_comp}" "${_plat}" "sha256")
      if(_err2)
        set(_sha "")
      endif()
      _nge_fetch_archive("https://developer.download.nvidia.com/compute/cuda/redist/" "${_rel}" "${_sha}" _dir)
      if(_dir)
        file(GLOB _dlls "${_dir}/bin/*.dll" "${_dir}/bin/x64/*.dll" "${_dir}/lib/libnvrtc.so.1*" "${_dir}/lib/libnvrtc-builtins.so.*")
        list(APPEND NGE_CUDA_DLLS ${_dlls})
        if(_comp STREQUAL "cuda_cudart")
          list(APPEND NGE_CUDART_INCLUDE_DIRS "${_dir}/include")
          set(NGE_CUDART_LIB "${_dir}/lib/x64/cudart.lib")
        endif()
      endif()
    endforeach()
    foreach(_comp IN LISTS NGE_CUDA_HEADER_COMPONENTS)
      string(JSON _rel ERROR_VARIABLE _err GET "${cuda_index}" "${_comp}" "${_plat}" "relative_path")
      if(_err)
        message(WARNING "CUDA redist index has no ${_plat} entry for ${_comp}: ${_err}")
        continue()
      endif()
      string(JSON _sha ERROR_VARIABLE _err2 GET "${cuda_index}" "${_comp}" "${_plat}" "sha256")
      if(_err2)
        set(_sha "")
      endif()
      _nge_fetch_archive("https://developer.download.nvidia.com/compute/cuda/redist/" "${_rel}" "${_sha}" _dir)
      if(_dir)
        list(APPEND NGE_CUDART_INCLUDE_DIRS "${_dir}/include")
      endif()
    endforeach()
  endif()
  if(WIN32)
    _nge_download_json("https://developer.download.nvidia.com/compute/cudnn/redist/redistrib_${NGE_CUDNN_REDIST_VERSION}.json" cudnn_index)
  endif()
  if(cudnn_index)
    string(JSON _rel ERROR_VARIABLE _err GET "${cudnn_index}" "cudnn" "windows-x86_64" "cuda12" "relative_path")
    if(_err)
      message(WARNING "cuDNN redist index: ${_err}")
    else()
      string(JSON _sha ERROR_VARIABLE _err2 GET "${cudnn_index}" "cudnn" "windows-x86_64" "cuda12" "sha256")
      if(_err2)
        set(_sha "")
      endif()
      _nge_fetch_archive("https://developer.download.nvidia.com/compute/cudnn/redist/" "${_rel}" "${_sha}" _dir)
      if(_dir)
        file(GLOB _dlls "${_dir}/bin/*.dll" "${_dir}/bin/x64/*.dll")
        list(APPEND NGE_CUDA_DLLS ${_dlls})
      endif()
    endif()
  endif()
else()
  if(NOT CUDA_PATH)
    set(CUDA_PATH "$ENV{CUDA_PATH}")
  endif()
  if(CUDA_PATH AND EXISTS "${CUDA_PATH}/bin/cudart64_12.dll")
    file(GLOB _dlls "${CUDA_PATH}/bin/cudart64_12*.dll" "${CUDA_PATH}/bin/cublas*64_12*.dll" "${CUDA_PATH}/bin/cufft64_11*.dll"
         "${CUDA_PATH}/bin/curand64_10*.dll" "${CUDA_PATH}/bin/nvrtc*.dll" "${CUDA_PATH}/bin/nvJitLink*.dll")
    list(APPEND NGE_CUDA_DLLS ${_dlls})
    set(NGE_CUDART_INCLUDE_DIRS "${CUDA_PATH}/include")
    set(NGE_CUDART_LIB "${CUDA_PATH}/lib/x64/cudart.lib")
  else()
    message(WARNING "NGE_CUDA_REDIST=OFF and no CUDA toolkit at CUDA_PATH='${CUDA_PATH}'")
  endif()
  if(NOT CUDNN_PATH)
    set(CUDNN_PATH "$ENV{CUDNN_PATH}")
  endif()
  if(CUDNN_PATH)
    file(GLOB _dlls "${CUDNN_PATH}/bin/*.dll" "${CUDNN_PATH}/bin/12.*/*.dll")
    list(APPEND NGE_CUDA_DLLS ${_dlls})
  else()
    message(WARNING "CUDNN_PATH not set: cuDNN DLLs will not be deployed")
  endif()
endif()

list(LENGTH NGE_CUDA_DLLS _n)
message(STATUS "CUDA runtime libraries to deploy: ${_n}")
if(_n EQUAL 0 AND WIN32)
  message(WARNING "no CUDA runtime DLLs found: the ONNX Runtime CUDA provider will fail to load")
endif()
